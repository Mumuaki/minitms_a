# Production Environment Variables для удаленного VPS
# Скопируйте этот файл в .env на VPS и заполните реальными значениями

# PostgreSQL
POSTGRES_PASSWORD=your_strong_postgres_password
POSTGRES_PORT=5432

# Redis
REDIS_PORT=6379

# Backend
BACKEND_PORT=8000

# Frontend
FRONTEND_PORT=80

# Database URL для backend (использует внутреннее имя хоста контейнера postgres)
DATABASE_URL=postgresql://postgres:your_strong_postgres_password@postgres:5432/mini-tms

# Redis URL для backend (использует внутреннее имя хоста контейнера redis)
REDIS_URL=redis://redis:6379/0
